# Copy to .env before running the loader or API. Do not commit .env.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=please-change-me
NEO4J_DATABASE=neo4j
REDIS_URL=redis://localhost:6379/0

# A versioned prefix makes the projection safe to rebuild beside other Redis data.
KG_NAMESPACE=viseca:history:v1
