digraph G {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.42, ranksep=0.58,
         fontname="Helvetica", fontsize=22, fontcolor="#12355B",
         label="Figure 3. Online authorization and hierarchical decision flow\nGraph evidence and probabilistic uncertainty complement—but never weaken—the guardrail.", labelloc=t];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
        color="#246BCE", fillcolor="#EAF2FC", fontcolor="#17212B", penwidth=1.7, margin="0.18,0.11"];
  edge [fontname="Helvetica", fontsize=9, color="#12355B", fontcolor="#12355B", penwidth=1.5, arrowsize=0.75];

  receive [label="1  Receive request\nauthorization + confirmed policy"];
  validate [label="2  Validate request\nschema • identity • deadline"];
  retrieve [label="3  Retrieve graph context\nbounded summary lookup", style="rounded,filled,dashed", color="#159A9C", fillcolor="#E7F7F6"];
  rules [label="4a  Deterministic evaluation\nFAIL • PASS • UNCERTAIN", color="#238636", fillcolor="#EAF7EC"];
  model [label="4b  Probabilistic evaluation\nGaussian likelihood + Bayesian posterior", style="rounded,filled,dashed", color="#6F42C1", fillcolor="#F2ECFB"];
  gate [shape=diamond, label="Decision\npolicy", style="filled,dashed", color="#D97706", fillcolor="#FFF4DE", width=1.5, height=1.0];
  approve [label="APPROVE\nrule pass + low uncertainty", style="rounded,filled,dashed", color="#238636", fillcolor="#EAF7EC"];
  stepup [label="STEP-UP\nmissing evidence or elevated uncertainty", style="rounded,filled,dashed", color="#D97706", fillcolor="#FFF4DE"];
  decline [label="DECLINE\nhard rule failure", style="rounded,filled,dashed", color="#C9363E", fillcolor="#FDEBEC"];
  persist [label="5  Persist decision and evidence\nrequest hash • reason codes • versions", style="rounded,filled,dashed"];

  receive -> validate -> retrieve;
  retrieve -> rules [label="policy facts", color="#238636", fontcolor="#238636"];
  retrieve -> model [label="context evidence", color="#6F42C1", fontcolor="#6F42C1"];
  rules -> gate [label="hard result", color="#238636", fontcolor="#238636"];
  model -> gate [label="uncertainty", color="#6F42C1", fontcolor="#6F42C1"];
  gate -> decline [label="rule FAIL", color="#C9363E", fontcolor="#C9363E"];
  gate -> approve [label="PASS + low", color="#238636", fontcolor="#238636"];
  gate -> stepup [label="otherwise", color="#D97706", fontcolor="#D97706"];
  approve -> persist; stepup -> persist; decline -> persist;
}

