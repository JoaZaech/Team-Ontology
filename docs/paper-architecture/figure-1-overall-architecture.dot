digraph G {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.45, ranksep=0.55,
         fontname="Helvetica", fontsize=22, fontcolor="#12355B",
         label="Figure 1. Hybrid wallet-control architecture\nHard rules are non-compensatory; graph and probabilistic components provide context and uncertainty.", labelloc=t];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
        color="#246BCE", fillcolor="#EAF2FC", fontcolor="#17212B", penwidth=1.7, margin="0.16,0.10"];
  edge [fontname="Helvetica", fontsize=9, color="#12355B", fontcolor="#12355B", penwidth=1.5, arrowsize=0.75];

  history [label="Historical transactions\nsample today; 100M+ target"];
  builder [label="Knowledge builder\nbatch + streaming summaries", style="rounded,filled,dashed", color="#159A9C", fillcolor="#E7F7F6"];
  knowledge [label="Online knowledge projection\ncard–merchant • card–device\ncategory • rolling activity", style="rounded,filled,dashed", color="#159A9C", fillcolor="#E7F7F6"];
  request [label="New authorization\ntransaction + confirmed mandate"];
  context [label="Context retrieval\nevidence bundle + provenance", style="rounded,filled,dashed", color="#159A9C", fillcolor="#E7F7F6"];
  rules [label="Deterministic rule engine\namount • mandate • basket\nmerchant • velocity", color="#238636", fillcolor="#EAF7EC"];
  gaussian [label="Gaussian anomaly model\ncontinuous behavioural deviation", style="rounded,filled,dashed", color="#6F42C1", fillcolor="#F2ECFB"];
  bayes [label="Bayesian evidence fusion\nposterior uncertainty", style="rounded,filled,dashed", color="#6F42C1", fillcolor="#F2ECFB"];
  policy [label="Hierarchical decision policy\nhard gate + uncertainty threshold", style="rounded,filled,dashed", color="#D97706", fillcolor="#FFF4DE"];
  approve [label="APPROVE", style="rounded,filled,dashed", color="#238636", fillcolor="#EAF7EC"];
  stepup [label="STEP-UP", style="rounded,filled,dashed", color="#D97706", fillcolor="#FFF4DE"];
  decline [label="DECLINE", style="rounded,filled,dashed", color="#C9363E", fillcolor="#FDEBEC"];
  ledger [label="Decision ledger\nrequest • evidence • versions", style="rounded,filled,dashed"];

  history -> builder -> knowledge;
  request -> context;
  knowledge -> context [label="bounded lookup", color="#159A9C", fontcolor="#159A9C"];
  context -> rules [label="facts"];
  context -> gaussian [label="numeric context", color="#6F42C1", fontcolor="#6F42C1"];
  context -> bayes [label="discrete evidence", color="#6F42C1", fontcolor="#6F42C1"];
  gaussian -> bayes [label="likelihood", color="#6F42C1", fontcolor="#6F42C1"];
  rules -> policy [label="pass / fail", color="#238636", fontcolor="#238636"];
  bayes -> policy [label="uncertainty", color="#6F42C1", fontcolor="#6F42C1"];
  policy -> approve [color="#238636"];
  policy -> stepup [color="#D97706"];
  policy -> decline [color="#C9363E"];
  approve -> ledger; stepup -> ledger; decline -> ledger;

  note [shape=note, label="Design invariant:\na hard policy violation cannot be diluted\nby graph or model scores.", color="#C9363E", fillcolor="#FDEBEC", fontcolor="#C9363E", style="filled", fontsize=10];
  rules -> note [style=dotted, arrowhead=none, color="#C9363E"];

  { rank=same; history; builder; knowledge; }
  { rank=same; request; context; }
  { rank=same; rules; gaussian; bayes; note; }
  { rank=same; approve; stepup; decline; }
}
