digraph G {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.48, ranksep=0.60,
         fontname="Helvetica", fontsize=22, fontcolor="#12355B",
         label="Figure 4. Human step-up resolution and feedback flow\nA provisional step-up affects approved spend only after customer resolution.", labelloc=t];
  node [shape=box, style="rounded,filled,dashed", fontname="Helvetica", fontsize=11,
        color="#246BCE", fillcolor="#EAF2FC", fontcolor="#17212B", penwidth=1.7, margin="0.18,0.11"];
  edge [fontname="Helvetica", fontsize=9, color="#12355B", fontcolor="#12355B", penwidth=1.5, arrowsize=0.75];

  stepup [label="STEP-UP\nprovisional decision", color="#D97706", fillcolor="#FFF4DE"];
  prompt [label="Customer prompt\npurchase facts + reasons\nmerchant text cannot alter policy"];
  approve [label="Customer approves", color="#238636", fillcolor="#EAF7EC"];
  reject [label="Customer rejects", color="#C9363E", fillcolor="#FDEBEC"];
  revoke [label="Customer revokes policy", color="#D97706", fillcolor="#FFF4DE"];
  ledger [label="Final decision ledger\napproved / declined / revoked\nhuman resolution + timestamp"];
  state [label="Online state update\nidempotency • rolling spend\nmerchant/device summaries", color="#159A9C", fillcolor="#E7F7F6"];
  labels [label="Outcome labels\naccepted/rejected step-up\nconfirmed fraud when available", color="#6F42C1", fillcolor="#F2ECFB"];
  recalibrate [label="Offline recalibration\npriors • thresholds • monitoring", color="#6F42C1", fillcolor="#F2ECFB"];

  stepup -> prompt;
  prompt -> approve [color="#238636"];
  prompt -> reject [color="#C9363E"];
  prompt -> revoke [color="#D97706"];
  approve -> ledger; reject -> ledger; revoke -> ledger;
  ledger -> state [label="final outcome", color="#159A9C", fontcolor="#159A9C"];
  ledger -> labels [label="feedback", color="#6F42C1", fontcolor="#6F42C1"];
  labels -> recalibrate [color="#6F42C1"];
  state -> prompt [label="future context", style=dashed, color="#159A9C", fontcolor="#159A9C", constraint=false];

  { rank=same; approve; reject; revoke; }
  { rank=same; state; labels; }
}
