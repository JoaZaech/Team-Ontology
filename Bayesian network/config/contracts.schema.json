{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-on-leash:bayesian:contracts:1",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "tenant": {
          "type": "string",
          "minLength": 1
        },
        "run": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "transaction_id": {
          "type": "string",
          "minLength": 1
        },
        "customer_id": {
          "type": "string",
          "minLength": 1
        },
        "card_id": {
          "type": "string",
          "minLength": 1
        },
        "merchant_id": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "transaction_time": {
          "type": "string",
          "minLength": 1
        },
        "decision_time": {
          "type": "string",
          "minLength": 1
        },
        "amount_cents": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "enum": [
            "strict",
            "synthetic_retrospective"
          ]
        }
      },
      "required": [
        "tenant",
        "run",
        "idempotency_key",
        "transaction_id",
        "customer_id",
        "card_id",
        "merchant_id",
        "country",
        "channel",
        "transaction_time",
        "decision_time",
        "amount_cents",
        "mode"
      ]
    },
    "rule_result": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "request_hash": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "enum": [
                  "pass",
                  "fail",
                  "unknown"
                ]
              }
            },
            "required": [
              "id",
              "result"
            ]
          }
        }
      },
      "required": [
        "version",
        "request_hash",
        "checks"
      ]
    },
    "fact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "tenant": {
          "type": "string",
          "minLength": 1
        },
        "run": {
          "type": "string",
          "minLength": 1
        },
        "event_time": {
          "type": "string",
          "minLength": 1
        },
        "known_at": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "known_at_basis": {
          "enum": [
            "actual_ingestion",
            "assumed_event_time"
          ]
        },
        "row": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "tenant",
        "run",
        "event_time",
        "known_at",
        "version",
        "known_at_basis",
        "row"
      ]
    },
    "feature": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "observed",
            "observed_novelty",
            "history_unavailable",
            "insufficient_history",
            "not_applicable"
          ]
        },
        "value": {
          "enum": [
            null,
            0,
            1
          ]
        },
        "sample_size": {
          "type": "integer",
          "minimum": 0
        },
        "coverage_days": {
          "type": "number",
          "minimum": 0
        },
        "support_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "state",
        "value",
        "sample_size",
        "coverage_days",
        "support_ids"
      ]
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "feature_hash": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "strict",
            "synthetic_retrospective"
          ]
        },
        "features": {
          "type": "object",
          "properties": {
            "merchant": {
              "$ref": "#/$defs/feature"
            },
            "country": {
              "$ref": "#/$defs/feature"
            },
            "device": {
              "$ref": "#/$defs/feature"
            },
            "amount": {
              "$ref": "#/$defs/feature"
            },
            "velocity": {
              "$ref": "#/$defs/feature"
            }
          },
          "required": [
            "merchant",
            "country",
            "device",
            "amount",
            "velocity"
          ]
        },
        "coverage": {
          "type": "object"
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "transaction_time": {
          "type": "string",
          "minLength": 1
        },
        "decision_time": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "object"
        }
      },
      "required": [
        "snapshot_id",
        "feature_hash",
        "mode",
        "features",
        "coverage",
        "provenance",
        "transaction_time",
        "decision_time",
        "scope"
      ]
    },
    "node": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "parents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cpt": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      },
      "required": [
        "name",
        "parents",
        "cpt"
      ]
    },
    "model": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "required": [
        "version",
        "target",
        "nodes"
      ]
    },
    "validation_report": {
      "type": "object",
      "properties": {
        "valid": {
          "const": true
        },
        "model_hash": {
          "type": "string",
          "minLength": 1
        },
        "normalization_tolerance": {
          "type": "number"
        }
      },
      "required": [
        "valid",
        "model_hash",
        "normalization_tolerance"
      ]
    },
    "influence": {
      "type": "object",
      "properties": {
        "feature": {
          "type": "string",
          "minLength": 1
        },
        "posterior": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "without_feature": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "delta": {
          "type": "number"
        },
        "comparison": {
          "const": "marginalize omitted evidence"
        },
        "interpretation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "feature",
        "posterior",
        "without_feature",
        "delta",
        "comparison",
        "interpretation"
      ]
    },
    "analysis": {
      "type": "object",
      "properties": {
        "baseline": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimum": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximum": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "scenarios": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "influence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/influence"
          }
        },
        "range_kind": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "baseline",
        "minimum",
        "maximum",
        "scenarios",
        "influence",
        "range_kind"
      ]
    },
    "receipt": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "input_hash": {
          "type": "string",
          "minLength": 1
        },
        "config_hash": {
          "type": "string",
          "minLength": 1
        },
        "feature_hash": {
          "type": "string",
          "minLength": 1
        },
        "implementation_hash": {
          "type": "string",
          "minLength": 1
        },
        "policy_hash": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "approve",
            "step_up",
            "decline"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "persisted": {
          "const": true
        },
        "receipt_hash": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/snapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "analysis": {
          "anyOf": [
            {
              "$ref": "#/$defs/analysis"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "scope",
        "request",
        "input_hash",
        "config_hash",
        "feature_hash",
        "implementation_hash",
        "policy_hash",
        "decision",
        "reason",
        "persisted",
        "receipt_hash",
        "snapshot",
        "analysis"
      ]
    },
    "resolution_event": {
      "type": "object",
      "properties": {
        "customer_id": {
          "type": "string",
          "minLength": 1
        },
        "event_key": {
          "type": "string",
          "minLength": 1
        },
        "receipt_scope": {
          "type": "string",
          "minLength": 1
        },
        "request_hash": {
          "type": "string",
          "minLength": 1
        },
        "resolved_at": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "approve",
            "reject",
            "revoke"
          ]
        }
      },
      "required": [
        "customer_id",
        "event_key",
        "receipt_scope",
        "request_hash",
        "resolved_at",
        "action"
      ]
    },
    "resolution": {
      "type": "object",
      "properties": {
        "event": {
          "$ref": "#/$defs/resolution_event"
        },
        "status": {
          "enum": [
            "approved",
            "customer_rejected",
            "authority_revoked",
            "approval_blocked"
          ]
        },
        "original_receipt_hash": {
          "type": "string",
          "minLength": 1
        },
        "resolution_hash": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "minLength": 1
        },
        "authentication": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "event",
        "status",
        "original_receipt_hash",
        "resolution_hash",
        "signature",
        "authentication"
      ]
    },
    "failure_response": {
      "type": "object",
      "properties": {
        "decision": {
          "enum": [
            "step_up",
            "decline"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "persisted": {
          "const": false
        }
      },
      "required": [
        "decision",
        "reason",
        "persisted"
      ]
    }
  }
}
